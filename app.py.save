from flask import Flask, request, jsonify
from flask_cors import CORS
import json
import os

app = Flask(__name__)
# Разрешаем фронтенду общаться с сервером
CORS(app)

DATA_FILE = 'db.json'

# Загружаем данные, если файл есть
def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, 'r', encoding='utf-8') as f:
            return json.load(f)
    return {'orders': [], 'users': []}

# Сохраняем данные в файл
def save_data(data):
    with open(DATA_FILE, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

# --- API ЭНДПОИНТЫ (Точки входа для запросов с сайта) ---

@app.route('/api/order', methods=['POST'])
def create_order():
    """Принимает заказ из корзины"""
    data = request.json
    db = load_data()
    
    # Генерируем номер заказа
    order_id = len(db['orders']) + 1
    order = {
        'id': order_id,
        'items': data.get('items', []),
        'total': data.get('total', 0),
        'name': data.get('name'),
        'phone': data.get('phone'),
        'address': data.get('address'),
        'delivery': data.get('delivery'),
        'comment': data.get('comment', ''),
        'status': 'new'
    }
    db['orders'].append(order)
    save_data(db)
    
    return jsonify({'success': True, 'orderId': order_id}), 201

@app.route('/api/register', methods=['POST'])
def register():
    """Регистрация нового пользователя"""
    data = request.json
    db = load_data()
    
    # Проверяем, есть ли уже такой email
    for user in db['users']:
        if user['email'] == data['email']:
            return jsonify({'success': False, 'message': 'Этот email уже занят'}), 400
    
    # Сохраняем нового пользователя
    db['users'].append({
        'name': data['name'], 
        'email': data['email'], 
        'password': data['password']
    })
    save_data(db)
    return jsonify({'success': True})

@app.route('/api/login', methods=['POST'])
def login():
    """Вход в аккаунт"""
    data = request.json
    db = load_data()
    
    # Ищем пользователя по email и паролю
    user = next((u for u in db['users'] if u['email'] == data['email'] and u['password'] == data['password']), None)
    
    if user:
        return jsonify({'success': True, 'user': {'name': user['name'], 'email': user['email']}})
    return jsonify({'success': False, 'message': 'Неверный email или пароль'}), 401

if __name__ == '__main__':
    app.run(port=5000, debug=True)
